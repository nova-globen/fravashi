<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The app runner (backlog 87, ADR 0027): the host-side service that builds and runs SOMEBODY ELSE'S application
    in sibling containers for the verifier, exposing a CLOSED set of operations (build, start, ready, logs, stop,
    remove, list) over a token-authenticated HTTP API that fravashi.exe hosts beside the bridge. It never executes
    what a spec says: it reads a spec into its own narrow model, refuses by name what that model does not carry,
    and builds every engine argument from a fixed template. Kestrel via FrameworkReference, like the bridge; no
    reference to the studio, the bridge or the launcher, so its whole security surface is in this project.
  -->
  <PropertyGroup>
    <RootNamespace>Fravashi.AppRunner</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fravashi.AppRunner.Tests" />
  </ItemGroup>

  <!-- The bridge release (docs/plans/rename-internal-names.md, phase 2): the former names an installed copy still carries
       are read from ONE file, Domain's FormerNames, linked here as source and compiled internal (FORMER_NAMES_LINKED).
       The cleanup release (phase 5) removes this link with the file. -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);FORMER_NAMES_LINKED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Fravashi.Domain\FormerNames.cs" Link="FormerNames.cs" />
  </ItemGroup>

</Project>
