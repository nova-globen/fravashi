@namespace Fravashi.Web.Components.Setup

@* A check box that can say "mixed" (item #373, section 8): a button with role checkbox, because a native checkbox's
   indeterminate state is a script-only property and aria-checked does not belong on one. Space and Enter press a
   button natively, so it toggles from the keyboard with no handler of its own. *@
<button type="button" role="checkbox" class="setup-check is-@State" aria-checked="@State" aria-label="@Label"
        data-testid="@TestId" disabled="@Disabled" @onclick="OnToggle">
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        @if (State == "true")
        {
            <path d="m2.5 6.2 2.4 2.4 4.6-5" />
        }
        else if (State == "mixed")
        {
            <path d="M3 6h6" />
        }
    </svg>
</button>

@code {
    /// <summary>"true", "false" or "mixed", as aria-checked takes it.</summary>
    [Parameter, EditorRequired]
    public string State { get; set; } = "false";

    /// <summary>What checking it does, for a screen reader: "Import docs/plan.md".</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }
}
