@namespace Fravashi.Web.Components.Setup

@* The small line icons of the recommended setup's plan (item #373). Drawn inline with currentColor, in the same
   1.2 px stroke the start dialog's icons use, so they follow the theme with no asset to load. Decorative: the line
   beside each says everything. *@
<span class="setup-glyph" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
        @switch (Kind)
        {
            case "project":
                <rect x="2" y="2.5" width="12" height="11" rx="2" />
                <path d="M2 6h12M5.5 9h5M5.5 11h3" />
                break;
            case "board":
                <rect x="2" y="2.5" width="3.5" height="11" rx="1" />
                <rect x="6.25" y="2.5" width="3.5" height="7" rx="1" />
                <rect x="10.5" y="2.5" width="3.5" height="9" rx="1" />
                break;
            case "branch":
                <circle cx="4.5" cy="3.5" r="1.5" />
                <circle cx="4.5" cy="12.5" r="1.5" />
                <circle cx="11.5" cy="5.5" r="1.5" />
                <path d="M4.5 5v6M11.5 7c0 2.5-3 2.5-6.2 4" />
                break;
            case "import":
                <path d="M4 2.5h5l3 3v8H4z" />
                <path d="M9 2.5v3h3M8 8v4M6.3 10.3 8 12l1.7-1.7" />
                break;
            case "agents":
                <rect x="3" y="5" width="10" height="8" rx="2" />
                <path d="M8 2.5V5M6 9h.01M10 9h.01M6.5 11h3" />
                break;
            case "check":
                <path d="m3.5 8.5 3 3 6-7" />
                break;
        }
    </svg>
</span>

@code {
    /// <summary>project, board, branch, import, agents or check.</summary>
    [Parameter, EditorRequired]
    public string Kind { get; set; } = string.Empty;
}
