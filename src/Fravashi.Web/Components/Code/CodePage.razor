@page "/code"
@page "/code/{*FilePath}"
@namespace Fravashi.Web.Components.Code
@using System.Text.Json
@using Fravashi.Application.Git
@using Fravashi.Application.Notifications
@using Fravashi.Application.Repository
@using Fravashi.Domain.Git
@using Fravashi.Domain.Repository
@using Fravashi.Infrastructure.Rendering
@using Fravashi.Web.Components.Shell
@using Fravashi.Web.Services
@inject IServiceProvider ServiceLookup
@using Microsoft.JSInterop
@inject TimeProvider Clock
@inject IRepositoryReader Reader
@inject IRepositoryWriter Writer
@inject IRepositoryTrash Trash
@inject IGitService Git
@inject IRepositoryChangeNotifier ChangeNotifier
@inject Fravashi.Infrastructure.Bridge.WorkspaceSelection Selection
@inject Fravashi.Infrastructure.Bridge.BridgeClient Bridge
@inject Fravashi.Application.Persistence.IWorkspaceStore WorkspaceStore
@inject Fravashi.Application.AgentSync.IWorkspaceAgentSync AgentSync
@inject CodeWorkspace Workspace
@inject AgentPanelState AgentPanel
@inject FileIconCatalog Icons
@inject MarkdownPreviewRenderer MarkdownPreview
@inject INotificationHistory Notifications
@inject NavigationManager Nav
@inject CircuitConnection Connection
@inject IJSRuntime JS
@inject ILogger<CodePage> Logger
@implements IAsyncDisposable

<PageTitle>@(ProductName.Short) · Code</PageTitle>

@* No PageBar here, deliberately: the Code page gives every vertical pixel to the editor. The title is
   redundant with the activity-bar selection, and notifications/theme live in the rail's bottom group.
   Without the bar the page still needs its one level-one heading (backlog 291), drawn for assistive
   technology only. It is a role, not an h1, on purpose: Routes.razor's FocusOnNavigate focuses the
   first h1 on arrival, and here that would take focus away from the editor. *@
<div class="studio-workitems code-page">
    <div class="code-page-heading" role="heading" aria-level="1" data-testid="code-page-heading">Code</div>
    <PageSplit SidebarLabel="Code sections" SidebarTestId="code-sidebar" BodyTestId="code-editor-pane"
               SidebarCssClass="code-sidebar" BodyCssClass="code-body">
        <Sidebar>
            <PageSidebarSection Title="Open Editors" TestId="code-open-editors" InitiallyCollapsed="true">
                <HeaderActions>
                    <button type="button" class="code-section-action" title="Save All (Ctrl+Shift+S, unsaved: @UnsavedCount)"
                            aria-label="Save all files" data-testid="code-save-all"
                            disabled="@(UnsavedCount == 0)" @onclick="SaveAllAsync">
                        <CodeIcon Kind="CodeIcon.IconKind.SaveAll" />
                    </button>
                    <button type="button" class="code-section-action" title="Close All"
                            aria-label="Close all editors" data-testid="code-close-all"
                            disabled="@(Workspace.Open.Count == 0)" @onclick="CloseAllGuardedAsync">
                        <CodeIcon Kind="CodeIcon.IconKind.CloseAll" />
                    </button>
                </HeaderActions>
                <ChildContent>
                    @if (Workspace.Open.Count == 0)
                    {
                        <p class="page-sidebar-empty">No open editors.</p>
                    }
                    else
                    {
                        @foreach (var file in Workspace.Open)
                        {
                            <div class="code-open-editor @(file.Path == Workspace.ActivePath ? "active" : string.Empty) @(IsUnsaved(file.Path) ? "dirty" : string.Empty)"
                                 @onclick="() => NavigateToFile(file.Path)">
                                <button type="button" class="code-tab-close" title="Close" aria-label="@($"Close {file.Name}")"
                                        @onclick="() => CloseAsync(file.Path)" @onclick:stopPropagation="true">
                                    <CodeIcon Kind="CodeIcon.IconKind.Close" />
                                </button>
                                <img class="code-icon" src="@Icons.FileIconUrl(file.Name)" alt="" aria-hidden="true" />
                                <span class="code-name">@file.Name</span>
                                <span class="code-open-editor-dir">@DirectoryOf(file.Path)</span>
                            </div>
                        }
                    }
                </ChildContent>
            </PageSidebarSection>

            <PageSidebarSection Title="Search" TestId="code-search" InitiallyCollapsed="true" @ref="_searchSection">
                <HeaderActions>
                    <button type="button" class="code-section-action" data-testid="code-search-view-toggle"
                            title="@(_searchPanel?.TreeView != false ? "View as list" : "View as tree")"
                            aria-label="@(_searchPanel?.TreeView != false ? "View results as a list" : "View results as a tree")"
                            @onclick="ToggleSearchViewAsync">
                        <CodeIcon Kind="@(_searchPanel?.TreeView != false ? CodeIcon.IconKind.ListFlat : CodeIcon.IconKind.ListTree)" />
                    </button>
                    <button type="button" class="code-section-action" title="Clear the search"
                            aria-label="Clear the search inputs and results" data-testid="code-search-refresh"
                            @onclick="ResetSearch">
                        <CodeIcon Kind="CodeIcon.IconKind.Refresh" />
                    </button>
                    <button type="button" class="code-section-action" title="Clear and close"
                            aria-label="Clear the search and collapse the section" data-testid="code-search-close"
                            @onclick="CloseSearch">
                        <CodeIcon Kind="CodeIcon.IconKind.Close" />
                    </button>
                </HeaderActions>
                <ChildContent>
                    @if (Reader.IsConfigured)
                    {
                        <CodeSearchPanel @ref="_searchPanel" OnOpenMatch="OpenMatchAsync" IsBufferDirty="IsUnsaved" ReplaceInBuffer="ReplaceInBufferAsync" />
                    }
                    else
                    {
                        <p class="page-sidebar-empty">Search needs a configured repository.</p>
                    }
                </ChildContent>
            </PageSidebarSection>

            <PageSidebarSection Title="@TreeTitle" TestId="code-tree">
                <HeaderActions>
                    <button type="button" class="code-section-action" data-testid="code-undo-fileop"
                            title="@(_lastFileOp is { } lastOp ? $"Undo: {lastOp.Label}" : "Nothing to undo (rename or delete first)")"
                            aria-label="Undo the last file operation" disabled="@(_lastFileOp is null)"
                            @onclick="UndoLastFileOpAsync">
                        <CodeIcon Kind="CodeIcon.IconKind.Undo" />
                    </button>
                    <button type="button" class="code-section-action" title="Refresh" aria-label="Refresh the tree"
                            data-testid="code-tree-refresh" @onclick="RefreshTreeAsync">
                        <CodeIcon Kind="CodeIcon.IconKind.Refresh" />
                    </button>
                    <button type="button" class="code-section-action" title="Collapse All" aria-label="Collapse all folders"
                            data-testid="code-tree-collapse-all" @onclick="CollapseAll">
                        <CodeIcon Kind="CodeIcon.IconKind.CollapseAll" />
                    </button>
                </HeaderActions>
                <ChildContent>
                    @if (!Reader.IsConfigured)
                    {
                        <p class="page-sidebar-empty" data-testid="code-tree-unconfigured">
                            No repository is configured yet. Open a folder or clone a repository; its working
                            copy appears here.
                        </p>
                    }
                    else if (_treeError is not null)
                    {
                        <p class="studio-error" data-testid="code-tree-error">@_treeError</p>
                    }
                    else if (_rootChildren is null)
                    {
                        <p class="page-sidebar-empty">Loading…</p>
                    }
                    else
                    {
                        <div class="code-tree-body" @oncontextmenu="OpenRootMenu" @oncontextmenu:preventDefault="true">
                            @foreach (var child in _rootChildren)
                            {
                                <CodeTreeNode Node="child" Expanded="_expanded" ChildrenCache="_childrenCache"
                                              OnToggle="ToggleDirectoryAsync" OnSelect="n => NavigateToFile(n.RelativePath)"
                                              OnContextMenu="OpenNodeMenu" SelectedPath="@Workspace.ActivePath" />
                            }
                        </div>
                    }
                </ChildContent>
            </PageSidebarSection>
        </Sidebar>
        <Body>
            @* Plan 2e Task 7: the editor and, beside it, the agent working in the same workspace. The
               panel is opened from AgentPanelToggle in the window chrome (backlog 23), so nothing in
               this split has to reserve width for a control while the panel is hidden. *@
            <div class="code-body-split @(AgentPanel.IsOpen ? "with-session" : string.Empty)">
            <div class="code-editor-area">
                @* Work item #366: the editor's own header. The tab rows on the left, and a labelled Agent toggle on
                   the right, because the title bar's unlabelled icon alone was a control the owner did not know was
                   there. Both drive the same AgentPanelState. *@
                <div class="code-editor-head">
                <div class="code-editor-head-tabs">
                @if (Workspace.Open.Count > 0)
                {
                    @if (Workspace.Pinned.Count > 0)
                    {
                        <div class="code-tabs-wrap code-tabs-pinned-row">
                            <button type="button" class="code-tab-scroll left" title="Scroll tabs" aria-label="Scroll tabs left"
                                    @onclick="() => ScrollTabsAsync(_pinnedRow, -1)"><CodeIcon Kind="CodeIcon.IconKind.Chevron" /></button>
                            <div class="code-tabs" role="tablist" @ref="_pinnedRow">
                                @foreach (var file in Workspace.Pinned)
                                {
                                    @TabTemplate(file)
                                }
                            </div>
                            <button type="button" class="code-tab-scroll right" title="Scroll tabs" aria-label="Scroll tabs right"
                                    @onclick="() => ScrollTabsAsync(_pinnedRow, 1)"><CodeIcon Kind="CodeIcon.IconKind.Chevron" /></button>
                        </div>
                    }
                    @if (Workspace.Unpinned.Count > 0)
                    {
                        <div class="code-tabs-wrap">
                            <button type="button" class="code-tab-scroll left" title="Scroll tabs" aria-label="Scroll tabs left"
                                    @onclick="() => ScrollTabsAsync(_unpinnedRow, -1)"><CodeIcon Kind="CodeIcon.IconKind.Chevron" /></button>
                            <div class="code-tabs" role="tablist" @ref="_unpinnedRow">
                                @foreach (var file in Workspace.Unpinned)
                                {
                                    @TabTemplate(file)
                                }
                            </div>
                            <button type="button" class="code-tab-scroll right" title="Scroll tabs" aria-label="Scroll tabs right"
                                    @onclick="() => ScrollTabsAsync(_unpinnedRow, 1)"><CodeIcon Kind="CodeIcon.IconKind.Chevron" /></button>
                        </div>
                    }
                }
                </div>
                <button type="button" class="code-agent-toggle @(AgentPanel.IsOpen ? "is-open" : string.Empty)"
                        data-testid="code-agent-toggle" aria-pressed="@(AgentPanel.IsOpen ? "true" : "false")"
                        title="@(AgentPanel.IsOpen ? "Hide the agent panel" : "Show the agent beside the code")"
                        @onclick="AgentPanel.Toggle">
                    Agent
                </button>
                </div>
                @if (Workspace.Open.Count > 0)
                {
                    @if (Workspace.Active is { } active)
                    {
                        <div class="code-breadcrumbs" data-testid="code-breadcrumbs">
                            @foreach (var (segment, index) in active.Path.Split('/').Select((s, i) => (s, i)))
                            {
                                @if (index > 0)
                                {
                                    <span class="code-breadcrumb-sep" aria-hidden="true">›</span>
                                }
                                <span class="code-breadcrumb">@segment</span>
                            }
                            <span class="code-breadcrumb-spacer"></span>
                            @if (_blame is { } blame && blame.Path == active.Path)
                            {
                                @* Line blame (VS Code style): who last touched the cursor line, with
                                   jumps to the commit and, when the message names one, the PR. *@
                                <span class="code-blame-chip" data-testid="code-blame-chip">
                                    @if (blame.Info is { } info)
                                    {
                                        <button type="button" class="code-blame-link" data-testid="code-blame-commit"
                                                title="@($"{info.Subject} ({info.ShortSha}). Click to view the commit.")"
                                                @onclick='() => Nav.NavigateTo($"/git/commit/{info.Sha}")'>
                                            @info.Author, @Relative(info.When) · @info.ShortSha
                                        </button>
                                        @if (info.PullRequestNumber is { } prNumber)
                                        {
                                            <button type="button" class="code-blame-link" data-testid="code-blame-pr"
                                                    title="View the pull request"
                                                    @onclick='() => Nav.NavigateTo($"/git/pr/{prNumber}")'>
                                                !@prNumber
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="code-blame-uncommitted">Line @blame.Line: not committed yet</span>
                                    }
                                </span>
                            }
                            @if (_view.PreviewMode != PreviewMode.None)
                            {
                                <button type="button" class="code-section-action code-preview-toggle" data-testid="code-preview-toggle"
                                        title="@(_previewActive ? "Show source" : "Open preview")"
                                        aria-label="@(_previewActive ? "Show source" : "Open preview")"
                                        @onclick="TogglePreview">
                                    <CodeIcon Kind="@(_previewActive ? CodeIcon.IconKind.Code : CodeIcon.IconKind.Preview)" />
                                </button>
                            }
                        </div>
                    }
                }
                @if (ActiveAlert is { } alert && Workspace.ActivePath is { } alertPath)
                {
                    @* External-change conflict surface (ADR 0016): never resolved silently. *@
                    <div class="code-file-alert" data-testid="code-file-alert" role="alert">
                        <span>
                            @(alert == FileAlert.ChangedOnDisk
                                ? "This file changed on disk (outside this editor)."
                                : "This file was deleted on disk.")
                        </span>
                        <span class="code-file-alert-actions">
                            @if (alert == FileAlert.ChangedOnDisk)
                            {
                                <button type="button" class="studio-btn studio-btn-alt" data-testid="code-alert-reload"
                                        @onclick="() => ReloadFromDiskAsync(alertPath)">Reload from disk</button>
                                <button type="button" class="studio-btn" data-testid="code-alert-overwrite"
                                        @onclick="() => OverwriteDiskAsync(alertPath)">Overwrite with my version</button>
                            }
                            else
                            {
                                <button type="button" class="studio-btn studio-btn-alt" data-testid="code-alert-close"
                                        @onclick="() => CloseAfterDeleteAsync(alertPath)">Close tab</button>
                                <button type="button" class="studio-btn" data-testid="code-alert-keep"
                                        @onclick="() => KeepDeletedAsync(alertPath)">Keep my copy (save recreates it)</button>
                            }
                        </span>
                    </div>
                }
                @if (FollowBandVisible)
                {
                    @* Work item #366: what follow did not do and why, and the pause after the person acted. *@
                    <div class="code-follow-band" data-testid="code-follow-band" role="status">
                        @if (_followNotice is { } notice)
                        {
                            <span class="code-follow-notice" data-testid="code-follow-notice">@notice.Text</span>
                            <span class="code-follow-band-actions">
                                @if (notice.Path is { } noticePath)
                                {
                                    <button type="button" class="studio-btn studio-btn-alt" data-testid="code-follow-notice-show"
                                            @onclick="() => ShowNoticedFile(noticePath)">Show it</button>
                                }
                                <button type="button" class="studio-btn studio-btn-alt" data-testid="code-follow-notice-dismiss"
                                        @onclick="() => _followNotice = null">Dismiss</button>
                            </span>
                        }
                        @if (FollowPaused)
                        {
                            <button type="button" class="code-follow-paused" data-testid="code-follow-paused"
                                    title="Following is paused because you used the editor; click to follow the agent again"
                                    @onclick="ResumeFollowAsync">
                                Following paused, resume
                            </button>
                        }
                    </div>
                }
                @if (_diff is { } diff)
                {
                    @* Work item #366: the change waiting on approval, as a read-only Monaco diff of the host file
                       against the proposed text. Approve and Deny here decide the SAME pending approval as the
                       card in the panel, through the same resolution, bound to this request id.
                       Work item #369: this header is a row of the editor column ABOVE the Monaco host, never laid
                       over it. Overlaid, the editor's minimap drew over Approve at the right edge (measured in a
                       1424 px window with the agent panel open), and the buttons wrap onto their own line when narrow. *@
                    <div class="code-follow-diff" data-testid="code-follow-diff" data-request="@diff.RequestId">
                        <div class="code-follow-diff-head" data-testid="code-follow-diff-head">
                            <span class="code-follow-diff-title">
                                Proposed change to <span class="code-follow-diff-path">@diff.Path</span>
                            </span>
                            @if (diff.Problem is null)
                            {
                                <span class="code-follow-diff-actions">
                                    <button type="button" class="studio-btn studio-btn-alt" data-testid="code-follow-deny"
                                            disabled="@_deciding" @onclick="() => DecideFromDiff(false)">Deny</button>
                                    <button type="button" class="studio-btn" data-testid="code-follow-approve"
                                            disabled="@_deciding" @onclick="() => DecideFromDiff(true)">Approve</button>
                                </span>
                            }
                        </div>
                    </div>
                }
                <div class="code-editor-host-wrap">
                    <div class="code-editor-host @(_view.Kind == ViewKind.Text && !_previewActive ? string.Empty : "code-editor-host-hidden")"
                         @ref="_editorHost"></div>
                    @if (_diff is { } diffBody)
                    {
                        @* The diff itself covers the editor; its header is above the wrap (#369). The editor host is
                           its own stacking context (studio.css), so Monaco's minimap cannot draw over this either. *@
                        <div class="code-follow-diff-body" data-testid="code-follow-diff-body">
                            @if (diffBody.Problem is { } problem)
                            {
                                <p class="code-follow-diff-problem" data-testid="code-follow-diff-problem">
                                    @problem Decide on the card in the agent panel, which shows the change as the agent sent it.
                                </p>
                            }
                            else
                            {
                                <div class="code-follow-diff-host" data-testid="code-follow-diff-host" @ref="_diffHost"></div>
                            }
                        </div>
                    }
                    @if (_previewActive && _view.PreviewMode == PreviewMode.Markdown)
                    {
                        <div class="code-md-preview" data-testid="code-md-preview">@((MarkupString)_previewHtml)</div>
                    }
                    else if (_previewActive && _view.PreviewMode == PreviewMode.Svg)
                    {
                        <div class="code-image-preview" data-testid="code-image-preview">
                            <img src="@_previewDataUrl" alt="@Workspace.Active?.Name" />
                        </div>
                    }
                    else if (_view.Kind == ViewKind.Image)
                    {
                        <div class="code-image-preview" data-testid="code-image-preview">
                            <img src="@_view.ImageDataUrl" alt="@Workspace.Active?.Name" />
                        </div>
                    }
                    else if (_view.Kind == ViewKind.Binary)
                    {
                        <div class="code-editor-empty" data-testid="code-binary-notice">
                            <p>@Workspace.Active?.Name is binary or too large, so it is not shown in the editor.</p>
                        </div>
                    }
                    else if (_view.Kind == ViewKind.Missing)
                    {
                        <div class="code-editor-empty" data-testid="code-missing-notice">
                            <p>@Workspace.Active?.Path could not be read; it may have been moved or deleted.</p>
                        </div>
                    }
                    else if (Workspace.Open.Count == 0)
                    {
                        <div class="code-editor-empty" data-testid="code-editor-empty">
                            @if (Reader.IsConfigured)
                            {
                                <p>Select a file from the tree to open it.</p>
                                <p class="studio-muted">Edits save with Ctrl+S; changes made on disk sync into open files.</p>
                            }
                            else
                            {
                                <p>No repository is configured yet.</p>
                                <p class="studio-muted">
                                    Open a folder or clone a repository; its working copy opens here.
                                </p>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (AgentPanel.IsOpen)
            {
                @* The panel's header is the pane's own now (backlog 18): New conversation has to be in
                   the same place here as it is in the Sessions area, and a second bar above the pane's
                   would have put it in two. What belongs to THIS surface rides in HeaderActions. *@
                <div class="code-session-panel" data-testid="code-session-panel">
                    <SessionPane WorkspaceId="@SessionWorkspaceId" WorkingDirectory="@SessionWorkingDirectory"
                                 SessionId="@PanelSessionId"
                                 SessionStarted="id => AgentPanel.Choose(id)"
                                 NewConversation="() => AgentPanel.Choose(null)"
                                 Compact="true" CopyStateChanged="StateHasChanged">
                        <HeaderActions>
                            @* Work item #366: the editor follows what the agent reads and changes while this is on. *@
                            <button type="button" class="session-head-action code-follow-toggle @(AgentPanel.FollowAgent ? "is-on" : string.Empty)"
                                    data-testid="code-follow-toggle" aria-pressed="@(AgentPanel.FollowAgent ? "true" : "false")"
                                    title="@(AgentPanel.FollowAgent ? "Following the agent in the editor; click to stop" : "Follow the agent in the editor")"
                                    @onclick="ToggleFollow">
                                Follow
                            </button>
                            @* "Open in Sessions": the conversation moves back to the Sessions area, and the panel closes
                               so it is not shown live in both places. *@
                            <a class="session-head-action" href="@OpenInSessionsHref" data-testid="code-session-open-area"
                               title="Open in Sessions" aria-label="Open in Sessions"
                               @onclick="AgentPanel.ReturnToSessions">&#8599;</a>
                            <button type="button" class="session-head-action" data-testid="code-session-close"
                                    title="Hide the agent panel" aria-label="Hide the agent panel"
                                    @onclick="AgentPanel.Close">
                                <CodeIcon Kind="CodeIcon.IconKind.Close" />
                            </button>
                        </HeaderActions>
                    </SessionPane>
                </div>
            }
            </div>
        </Body>
    </PageSplit>
</div>

@if (_menu is { } menu)
{
    <CodeContextMenu Items="menu.Items" X="menu.X" Y="menu.Y" OnDismiss="() => _menu = null" />
}

@if (_switcherOpen)
{
    @* The Ctrl+Tab quick switcher (VS style): most-recently-used order, selection follows repeated
       Tab presses while Ctrl is held, releasing Ctrl commits (wired in codeEditor.js). *@
    <div class="code-switcher" data-testid="code-switcher">
        <div class="code-switcher-title">Open editors</div>
        @foreach (var (file, index) in Workspace.RecentFirst.Select((f, i) => (f, i)))
        {
            <div class="code-switcher-item @(index == _switcherIndex ? "active" : string.Empty)">
                <img class="code-icon" src="@Icons.FileIconUrl(file.Name)" alt="" aria-hidden="true" />
                <span class="code-name">@file.Name</span>
                <span class="code-switcher-dir">@DirectoryOf(file.Path)</span>
            </div>
        }
    </div>
}

@if (_prompt is { } prompt)
{
    @* Backlog 27: the box is focused on open and owns Enter (create) and Escape (dismiss); the
       handler sits on the modal so it still fires once focus has moved to one of the buttons. *@
    <div class="studio-modal-backdrop" @onclick="() => _prompt = null">
        <div class="studio-modal" @onclick:stopPropagation="true" @onkeydown="NamePromptKeyDownAsync">
            <h2>@(prompt.IsFile ? "New file" : "New folder")</h2>
            <label class="studio-modal-field">
                <span>@(prompt.TargetDirectory.Length == 0 ? "At the repository root" : $"Inside {prompt.TargetDirectory}")</span>
                <input class="studio-input" placeholder="@(prompt.IsFile ? "name.ext" : "name")" @bind="_promptName"
                       @bind:event="oninput" data-testid="code-prompt-name" />
            </label>
            @if (_promptError is not null)
            {
                <p class="studio-error">@_promptError</p>
            }
            <div class="studio-modal-actions">
                <button type="button" class="studio-btn studio-btn-alt" @onclick="() => _prompt = null">Cancel</button>
                <button type="button" class="studio-btn" data-testid="code-prompt-create"
                        disabled="@string.IsNullOrWhiteSpace(_promptName)" @onclick="ConfirmPromptAsync">Create</button>
            </div>
        </div>
    </div>
}

@if (_rename is { } rename)
{
    <div class="studio-modal-backdrop" @onclick="() => _rename = null">
        <div class="studio-modal" @onclick:stopPropagation="true" @onkeydown="RenamePromptKeyDownAsync">
            <h2>Rename @(rename.IsDirectory ? "folder" : "file")</h2>
            <label class="studio-modal-field">
                <span>@rename.Path</span>
                <input class="studio-input" @bind="_renameName" @bind:event="oninput" data-testid="code-rename-name" />
            </label>
            @if (_renameError is not null)
            {
                <p class="studio-error">@_renameError</p>
            }
            <div class="studio-modal-actions">
                <button type="button" class="studio-btn studio-btn-alt" @onclick="() => _rename = null">Cancel</button>
                <button type="button" class="studio-btn" data-testid="code-rename-confirm"
                        disabled="@string.IsNullOrWhiteSpace(_renameName)" @onclick="ConfirmRenameAsync">Rename</button>
            </div>
        </div>
    </div>
}

@if (_deleteTarget is { } deleteTarget)
{
    <div class="studio-modal-backdrop" @onclick="() => _deleteTarget = null">
        <div class="studio-modal" data-testid="code-delete-confirm" @onclick:stopPropagation="true">
            <h2>Delete @(deleteTarget.IsDirectory ? "folder" : "file")</h2>
            <p class="studio-muted">
                @deleteTarget.Path will be removed from the working tree. A zip copy goes to the data
                directory's trash folder first (trash/date_[branch].zip), so this can be recovered by hand.
            </p>
            @if (OpenTabsUnder(deleteTarget.Path).Any(IsUnsaved))
            {
                <p class="studio-error">
                    Unsaved changes in the open editor@(OpenTabsUnder(deleteTarget.Path).Count(IsUnsaved) == 1 ? "" : "s")
                    for this path are discarded; only the on-disk content reaches the trash zip.
