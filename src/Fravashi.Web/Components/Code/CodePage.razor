    // ---- Pasting an image into a markdown buffer (backlog 26) ----

    /// <summary>
    /// codeEditor.js caught an image pasted into a markdown buffer and holds its bytes under <paramref name="id"/>.
    /// The image is pulled as a stream (never through invokeMethodAsync's 32 KB cap), saved beside the file
    /// through the root-bounded writer, and its relative link replaces the selection the paste was made on.
    /// Nothing happens to the buffer when the save fails: the reader is told why instead.
    /// </summary>
    [JSInvokable]
    public async Task EditorImagePasted(string path, string id, long size)
    {
        if (!MarkdownImagePaster.IsMarkdown(path))
        {
            await ForgetPastedImageAsync(id);
            return;
        }

        if (size > MarkdownImagePaster.MaxBytes)
        {
            await ForgetPastedImageAsync(id);
            await InvokeAsync(() => Notifications.Add("The pasted image is larger than 25 MB.", NotificationSeverity.Warning));
            return;
        }

        byte[] bytes;
        try
        {
            await using var reference = await JS.InvokeAsync<IJSStreamReference?>("fravashiImagePaste.take", id);
            if (reference is null)
            {
                await ForgetPastedImageAsync(id);
                return;
            }

            await using var stream = await reference.OpenReadStreamAsync(maxAllowedSize: MarkdownImagePaster.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            bytes = buffer.ToArray();
        }
        catch (Exception ex) when (ex is JSException or IOException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Reading an image pasted into {Path} failed.", path);
            await ForgetPastedImageAsync(id);
            await InvokeAsync(() => Notifications.Add("The pasted image could not be read.", NotificationSeverity.Warning));
            return;
        }

        var result = await new MarkdownImagePaster(Writer).PasteAsync(path, bytes);
        await InvokeAsync(async () =>
        {
            if (!result.Succeeded)
            {
                await ForgetPastedImageAsync(id);
                Notifications.Add(result.Error ?? "The pasted image could not be saved.", NotificationSeverity.Warning);
                return;
            }

            await JS.InvokeAsync<bool>("fravashiCode.insertPastedImage", id, result.Markdown);
            await RefreshTreeAsync();
        });
    }

    private async Task ForgetPastedImageAsync(string id)
    {
        try
        {
            await JS.InvokeVoidAsync("fravashiCode.forgetPastedImage", id);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone and the page's pending paste with it.
        }
    }

    // ---- Editing, save, and external-change sync (phase 2, ADR 0016) ----

    /// <summary>Client-side dirty transitions land here (Monaco content vs its last saved version).</summary>
    [JSInvokable]
    public Task SetDirty(string path, bool isDirty) => InvokeAsync(() =>
    {
        var changed = isDirty ? _dirty.Add(path) : _dirty.Remove(path);
        if (isDirty)
        {
            // Work item #366: an edited preview tab is the person's now, so the next follow never replaces it.
            Workspace.Promote(path);
        }

        if (changed)
        {
            StateHasChanged();
        }
    });

    [JSInvokable]
    public Task HotkeySave() => InvokeAsync(async () =>
