    /// <summary>Replace inside an open dirty buffer (the model is the truth; disk writes would clobber it).</summary>
    private async Task<int> ReplaceInBufferAsync(CodeSearchPanel.BufferReplaceRequest request)
    {
        var replaced = await JS.InvokeAsync<int>(
            "fravashiCode.replaceInBuffer",
            request.Path, request.Pattern, request.IsRegex, request.CaseSensitive, request.WholeWord,
            request.Replacement, request.Line ?? 0, request.Column ?? 0);
        if (replaced > 0)
        {
            _dirty.Add(request.Path);
            StateHasChanged();
        }

        return replaced;
    }

    // ---- Open / close / preview ----

    private void NavigateToFile(string path)
    {
        // Work item #366: a tab, tree or editors-list click is the person switching files, which pauses follow.
        NotePersonActivity();
        Nav.NavigateTo($"/code/{path}");
    }

    /// <summary>Open a file (from the URL): read it fresh, classify text/image/binary, and stage the render.</summary>
    private async Task OpenFromPathAsync(string path)
    {
        var name = path.Contains('/', StringComparison.Ordinal) ? path[(path.LastIndexOf('/') + 1)..] : path;
        var extension = System.IO.Path.GetExtension(path);
        // Backlog 265: two opens can be in flight at once (the first render's session restore and
        // OnParametersSet both open a file), and each reads before it stages. The open requested LAST
        // decides the view, so an earlier one that finishes later gives up rather than staging over it.
        var ticket = ++_openSequence;
        var wasPreviewActive = _previewActive;
        _previewActive = false;
        _blame = null; // the chip belongs to the previous buffer's cursor
        await RevealInTreeAsync(path);
        if (ticket != _openSequence || _disposed)
        {
            return;
        }

        if (ImageMimeTypes.TryGetValue(extension, out var mime))
        {
            var bytes = await Reader.ReadBytesAsync(path);
            if (ticket != _openSequence || _disposed)
            {
                return;
            }

            if (bytes is null && await DropMissingPreviewAsync(path, wasPreviewActive))
            {
                return; // work item #371: a missing file's preview tab closes itself
            }

            _view = bytes is null
                ? new ActiveView(ViewKind.Missing)
                : new ActiveView(ViewKind.Image, $"data:{mime};base64,{Convert.ToBase64String(bytes)}");
            OpenTab(path, name);
            _pendingPersist = true;
            return;
        }

        var file = await Reader.ReadFileAsync(path);
        if (ticket != _openSequence || _disposed)
        {
            return;
        }

        if (file is null)
        {
            if (await DropMissingPreviewAsync(path, wasPreviewActive))
            {
                return; // work item #371: a missing file's preview tab closes itself
            }

            _view = new ActiveView(ViewKind.Missing);
            OpenTab(path, name);
            _pendingPersist = true;
            return;
        }

        // Null bytes mean binary content ReadAllText already mangled, and a truncated read is a
        // placeholder, not the file; neither must ever reach an editable buffer (a save would
        // destroy the real content).
        if (file.IsTruncated || file.Content.Contains('\0', StringComparison.Ordinal))
        {
            _view = new ActiveView(ViewKind.Binary);
            OpenTab(path, name);
            _pendingPersist = true;
            return;
        }

        // Focus-time staleness check (ADR 0016): the watcher can miss events on exotic mounts, so
        // compare the disk timestamp against the one the buffer is based on every activation.
        if (file.LastWriteUtc is { } diskStamp)
        {
            if (_known.TryGetValue(path, out var basedOn) && basedOn != diskStamp)
            {
                if (IsUnsaved(path))
                {
                    _alerts[path] = FileAlert.ChangedOnDisk;
                }
                else
                {
                    _pendingStaleApply = (path, file.Content, diskStamp.ToString("O"));
                    _known[path] = diskStamp;
                    _alerts.Remove(path);
                }
            }
            else if (!_known.ContainsKey(path))
            {
                _known[path] = diskStamp;
            }
        }

        var previewMode = extension.ToLowerInvariant() switch
        {
            ".md" or ".markdown" => PreviewMode.Markdown,
            ".svg" => PreviewMode.Svg,
            _ => PreviewMode.None,
        };
        _view = new ActiveView(ViewKind.Text,
            TextContent: previewMode == PreviewMode.None ? null : file.Content,
            PreviewMode: previewMode);
        OpenTab(path, name);
        _pendingMonacoOpen = (path, file.Content, file.LastWriteUtc?.ToString("O"));
        _pendingPersist = true;
    }

    /// <summary>
    /// Expand every ancestor folder of <paramref name="path"/> (loading children as needed) so the
    /// active file is visible in the tree even after Collapse All, VS Code's reveal behavior.
    /// </summary>
    private async Task RevealInTreeAsync(string path)
    {
        if (!Reader.IsConfigured || !path.Contains('/', StringComparison.Ordinal))
        {
            return;
        }

        var segments = path.Split('/');
        var current = string.Empty;
        for (var i = 0; i < segments.Length - 1; i++)
        {
            current = current.Length == 0 ? segments[i] : $"{current}/{segments[i]}";
            _expanded.Add(current);
            if (!_childrenCache.ContainsKey(current))
            {
                var loaded = await Reader.GetTreeAsync(current);
                _childrenCache[current] = loaded.Children;
            }
        }
    }

    private void TogglePreview()
    {
        _previewActive = !_previewActive;
        if (!_previewActive)
        {
            return;
        }

        if (_view.PreviewMode == PreviewMode.Markdown)
        {
            _previewHtml = MarkdownPreview.ToHtml(_view.TextContent);
        }
        else if (_view.PreviewMode == PreviewMode.Svg)
        {
            _previewDataUrl = "data:image/svg+xml;base64,"
                + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_view.TextContent ?? string.Empty));
        }
    }

    private Task CloseAsync(string path)
    {
        if (IsUnsaved(path))
        {
            _pendingClose = new PendingClose([path], () => DoCloseAsync(path));
            StateHasChanged();
            return Task.CompletedTask;
        }

        return DoCloseAsync(path);
    }

    private async Task DoCloseAsync(string path)
    {
        var wasActive = Workspace.ActivePath == path;
        Workspace.Close(path);
        await JS.InvokeVoidAsync("fravashiCode.close", path);
        ForgetFileState(path);
        _pendingPersist = true;
        if (!wasActive)
        {
            return;
        }

        if (Workspace.ActivePath is { } next)
        {
            // Load the neighbor directly: OnParametersSet skips it (it is already the active path).
            await OpenFromPathAsync(next);
            Nav.NavigateTo($"/code/{next}");
        }
        else
        {
            _view = new ActiveView(ViewKind.None);
            Nav.NavigateTo("/code");
        }
    }

    private async Task ScrollTabsAsync(ElementReference row, int direction)
    {
        await JS.InvokeVoidAsync("fravashiCode.scrollTabs", row, direction);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("fravashiCode.bindHotkeys", _selfRef);
            await RestoreSessionAsync();
        }

        // Item #373 (the v0.9.100 check): a page left while its first render was still restoring (the window moved to
        // the setup) carries on in the background once its awaits return. The editor is ONE per window in codeEditor.js,
        // so an abandoned page that went on to init and open would take the editor from the page now on screen, and
        // its restore would navigate the window back to its file. Past this point it does nothing.
        if (_disposed)
        {
            return;
        }

        if (_pendingMonacoOpen is { } pending)
        {
            _pendingMonacoOpen = null;
            if (!_editorInitialized)
            {
                await JS.InvokeVoidAsync("fravashiCode.init", _editorHost);
                _editorInitialized = true;
            }

            // Work item #366: a file follow opens never takes focus (the person may be typing in the composer).
            var opened = _openWithoutFocus.Remove(pending.Path)
                ? await JS.InvokeAsync<BackupOpenResult?>(
                    "fravashiCode.open", pending.Path, pending.Content, pending.Stamp, true)
                : await JS.InvokeAsync<BackupOpenResult?>(
                    "fravashiCode.open", pending.Path, pending.Content, pending.Stamp);
            if (opened is { BackupApplied: true })
            {
                // Hot exit restored unsaved edits into this buffer. The buffer is based on the disk
                // state recorded at backup time; if the file moved on since, surface the conflict
                // banner instead of letting a save clobber the newer disk content.
                _dirty.Add(pending.Path);
                if (DateTimeOffset.TryParse(opened.BaseStamp, null, System.Globalization.DateTimeStyles.RoundtripKind, out var basedOn))
                {
                    _known[pending.Path] = basedOn;
                    if (pending.Stamp is { } diskStampText
                        && DateTimeOffset.TryParse(diskStampText, null, System.Globalization.DateTimeStyles.RoundtripKind, out var diskStamp)
                        && diskStamp != basedOn)
                    {
                        _alerts[pending.Path] = FileAlert.ChangedOnDisk;
                    }
                }

                StateHasChanged();
            }

            if (_pendingStaleApply is { } stale)
            {
                // The disk moved on while this tab was inactive and the buffer is clean: sync it now.
                _pendingStaleApply = null;
                await JS.InvokeVoidAsync("fravashiCode.applyExternalContent", stale.Path, stale.Content, stale.Stamp);
            }

            if (_pendingMatchReveal is { } reveal && reveal.Path == pending.Path)
            {
                _pendingMatchReveal = null;
                await JS.InvokeVoidAsync("fravashiCode.revealMatch", reveal.Path, reveal.Line, reveal.Column, reveal.Length);
            }
        }

        // Work item #366: what following the agent still has to push to the editor (bounded, re-sent on reconnect).
        await PushFollowAsync();

        if (_pendingFocus is { } focus)
        {
            // A modal box just appeared: focus it now that it exists in the DOM (backlog 27).
            _pendingFocus = null;
            try
            {
                await JS.InvokeVoidAsync("fravashiCode.focusElement", focus.Selector, focus.SelectAll);
            }
            catch (JSException)
            {
                // Focus is best-effort.
            }
        }

        if (_pendingPersist)
        {
            _pendingPersist = false;
            await PersistSessionAsync();
        }

        // Section sizing (defaults: search 50%, open editors 30%, tree the rest; user drags win) is
        // re-applied after every render since expand/collapse changes the visible set.
        await JS.InvokeVoidAsync("fravashiSections.apply", "[data-testid=code-sidebar]", "fravashi-sections-code",
            new Dictionary<string, double> { ["code-open-editors"] = 30, ["code-search"] = 50 });

        // Tab rows re-render on every tab change; re-evaluate their overflow state each time, and
        // bring a newly activated tab into view when its row is scrolled.
        await JS.InvokeVoidAsync("fravashiCode.updateTabStrips");
        if (Workspace.ActivePath is { } activeTab && activeTab != _lastRevealedTab)
        {
            _lastRevealedTab = activeTab;
            await JS.InvokeVoidAsync("fravashiCode.revealActiveTab");
            await JS.InvokeVoidAsync("fravashiCode.revealTreeSelection");
        }
    }

    /// <summary>Rehydrate the tab session from localStorage (refresh survival, VS Code style).</summary>
    private async Task RestoreSessionAsync()
    {
        if (_restoreAttempted)
        {
            return;
        }

        _restoreAttempted = true;
        if (!Reader.IsConfigured)
        {
            return;
        }

        try
        {
            // Plan 2b-ii: sessions and hot-exit backups are per workspace (one origin serves
            // several windows now). Must be set before loadWorkspace/listBackups.
            await JS.InvokeVoidAsync("fravashiCode.setWorkspaceScope", Selection.WorkspaceId ?? "local");
            var json = await JS.InvokeAsync<string?>("fravashiCode.loadWorkspace");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var saved = JsonSerializer.Deserialize<SavedSession>(json);
                if (saved?.Open is { Count: > 0 } open)
                {
                    Workspace.Hydrate(
                        open.Select(f => new CodeWorkspace.OpenFile(f.P ?? string.Empty, f.N ?? string.Empty, f.Pi == true)).ToList(),
                        saved.Active);
                }
            }
        }
        catch (JsonException)
        {
            // A corrupt saved session is not worth failing the page over; start clean.
        }

        // Hot exit (ADR 0016 addendum): tabs whose unsaved buffers survived the last session come back
        // dirty immediately (their content applies lazily when each tab is opened; Save All can persist
        // them straight from the backup). The recorded base timestamp seeds the conflict tracking so a
        // file that moved on while the app was closed still hits the banner, never a silent overwrite.
        try
        {
            var backups = await JS.InvokeAsync<BackupEntry[]?>("fravashiCode.listBackups") ?? [];
            foreach (var backup in backups)
            {
                if (Workspace.Open.All(f => f.Path != backup.Path))
                {
                    // The tab was closed after the backup was written (rare crash-window orphan).
                    await JS.InvokeVoidAsync("fravashiCode.clearBackup", backup.Path);
                    continue;
                }

                _dirty.Add(backup.Path);
                if (DateTimeOffset.TryParse(backup.BaseStamp, null, System.Globalization.DateTimeStyles.RoundtripKind, out var basedOn))
                {
                    _known[backup.Path] = basedOn;
                }
            }
        }
        catch (JSException)
        {
            // No backups restorable; the session still opens with disk content.
        }

        if (_disposed)
        {
            return; // item #373: the page was left while it restored; see OnAfterRenderAsync
        }

        // The URL wins over the restored active tab; without one, surface the session's active file. Both
        // load directly here because OnParametersSet skips a path that is already the active tab (page
        // return and refresh both land in that case, with the Monaco models long gone). Backlog 265: this
        // runs from the FIRST render, which comes before OnParametersSet whenever OnInitializedAsync awaits
        // (the root listing goes to the bridge), so the route's file must be opened here by name. Opening
        // the stored active tab instead put a second open in flight beside OnParametersSet's, and the
        // one that finished last decided the editor.
        if (!string.IsNullOrEmpty(FilePath))
        {
            if (_view.Kind == ViewKind.None || Workspace.ActivePath != FilePath)
            {
                await OpenFromPathAsync(FilePath);
            }
        }
        else if (Workspace.ActivePath is { } active && _view.Kind == ViewKind.None)
        {
            await OpenFromPathAsync(active);
            if (_disposed)
            {
                return; // item #373: never navigate the window from a page it has already left
            }

            Nav.NavigateTo($"/code/{active}", replace: true);
        }

        StateHasChanged();
    }

    private async Task PersistSessionAsync()
    {
        var session = new SavedSession
        {
            Open = Workspace.Open.Select(f => new SavedFile { P = f.Path, N = f.Name, Pi = f.IsPinned ? true : null }).ToList(),
            Active = Workspace.ActivePath,
        };
        try
        {
            await JS.InvokeVoidAsync("fravashiCode.saveWorkspace", JsonSerializer.Serialize(session));
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone mid-persist; the next page load restores whatever was last saved.
        }
    }

    private sealed class SavedSession
    {
        public List<SavedFile>? Open { get; set; }
        public string? Active { get; set; }
    }

    private sealed class SavedFile
    {
        public string? P { get; set; }
        public string? N { get; set; }
        public bool? Pi { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        Workspace.Changed -= OnWorkspaceChanged;
        AgentPanel.Changed -= OnAgentPanelChanged;
        AgentPanel.Detach();
        _changeSubscription?.Dispose();
        Connection.Reconnected -= OnReconnected;
        _disposed = true;
        StopFollow();
        try
        {
            await JS.InvokeVoidAsync("fravashiCode.unbindHotkeys");
            // Work item #366: the follow diff's models go before dispose takes every model with it.
            await JS.InvokeVoidAsync("fravashiCode.disposeDiff");
            await JS.InvokeVoidAsync("fravashiCode.dispose");
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone; nothing to clean client-side.
        }
        catch (InvalidOperationException)
        {
            // The PRERENDER instance disposing: it never had a JS runtime to clean up.
        }
        finally
        {
            _selfRef?.Dispose();
        }
    }

    private static string DirectoryOf(string path)
    {
        var slash = path.LastIndexOf('/');
        return slash <= 0 ? string.Empty : path[..slash];
    }

    private static string FileNameOf(string path)
    {
        var slash = path.LastIndexOf('/');
        return slash < 0 ? path : path[(slash + 1)..];
    }
}
