    /// <summary>
    /// The cursor settled on a line (debounced client-side): ask git blame who changed it last and
    /// surface the answer inline in the editor plus as clickable chips in the breadcrumb row.
    /// </summary>
    [JSInvokable]
    public Task CursorLineChanged(string path, int line) => InvokeAsync(async () =>
    {
        if (!Git.IsAvailable)
        {
            return;
        }

        GitLineBlame? info;
        try
        {
            info = await Git.GetLineBlameAsync(path, line);
        }
        catch (InvalidOperationException)
        {
            return; // outside the repository or blame failed; no chrome for this line
        }

        _blame = (path, line, info);
        var text = info is null
            ? "You, not committed yet"
            : $"{info.Author}, {Relative(info.When)} · {info.Subject}";
        try
        {
            await JS.InvokeVoidAsync("fravashiCode.showLineBlame", path, line, text);
        }
        catch (JSException)
        {
            // The buffer moved on; the next cursor stop retries.
        }

        StateHasChanged();
    });

    private string Relative(DateTimeOffset when) =>
        Fravashi.Web.Services.RelativeTime.Since(when, Clock.GetUtcNow(), zone: PersonTimeZone.Of(ServiceLookup)?.Zone);

    private async Task SaveAllAsync()
    {
        foreach (var path in _dirty.Union(_forceSave).ToList())
        {
            await SaveAsync(path);
        }
    }

    /// <summary>
    /// Persist a buffer: stream the model's bytes from the client (no 32 KB SignalR cap) and write
    /// through the root-bounded writer with a timestamp conflict check. A force-marked file (the user
    /// chose Overwrite / Keep-my-copy on the conflict banner) writes unconditionally.
    /// </summary>
    private async Task SaveAsync(string path)
    {
        var force = _forceSave.Contains(path);
        if (!force && !_dirty.Contains(path))
        {
            return;
        }

        IJSStreamReference? content;
        try
        {
            content = await JS.InvokeAsync<IJSStreamReference?>("fravashiCode.getContent", path);
        }
        catch (JSException)
        {
            content = null;
        }

        if (content is null)
        {
            return;
        }

        await using (content)
        {
            await using var stream = await content.OpenReadStreamAsync(maxAllowedSize: 32L * 1024 * 1024);
            var expected = !force && _known.TryGetValue(path, out var known) ? known : (DateTimeOffset?)null;
            var result = await Writer.SaveFileAsync(path, stream, expected);
            if (result.Conflict)
            {
                _alerts[path] = FileAlert.ChangedOnDisk;
            }
            else if (!result.Succeeded)
            {
                Notifications.Add(result.Error ?? $"Saving {path} failed.", NotificationSeverity.Error);
            }
            else
            {
                if (result.LastWriteUtc is { } written)
                {
                    _known[path] = written;
                }

                _dirty.Remove(path);
                _forceSave.Remove(path);
                _alerts.Remove(path);
                await JS.InvokeVoidAsync("fravashiCode.markSaved", path, result.LastWriteUtc?.ToString("O"));
            }
        }

        StateHasChanged();
    }

    private void OnRepositoryChanged(RepositoryChange change)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await HandleRepositoryChangeAsync(change);
            }
            catch (JSDisconnectedException)
            {
                // Circuit going away; the next circuit re-reads from disk anyway.
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Handling a repository change for {Path} failed.", change.RelativePath);
            }
        });
    }

    private async Task HandleRepositoryChangeAsync(RepositoryChange change)
    {
        // Empty path = anything may have changed: a watcher overflowed, or the bridge's stream came back after a gap in
        // which the bridge kept nothing (backlog 257). Refresh the tree, and check every open buffer against its file by
        // the same rules as one external edit (ADR 0016): a clean one reloads, an unsaved one gets the banner and is
        // never replaced. The bridge subscriber sends this at most once per 30 s.
        if (change.RelativePath.Length == 0)
        {
            QueueTreeRefresh();
            await LookAgainAtOpenBuffersAsync();
            return;
        }

        var path = change.RelativePath;
        var parent = DirectoryOf(path);
        if (parent.Length == 0 || _expanded.Contains(parent))
        {
            QueueTreeRefresh();
        }

        if (Workspace.Open.All(f => f.Path != path))
        {
            // Work item #366: a file the agent was shown creating has appeared on the host.
            await OpenLandedNewFileAsync(path, change.Kind);
            return;
        }

        await CheckOpenFileAsync(path, change.Kind);
    }

    /// <summary>Checks every loaded open buffer against its file, by the rules of one external edit (ADR 0016).</summary>
    private async Task LookAgainAtOpenBuffersAsync()
    {
        // A tab with no known disk stamp was never loaded in this circuit: nothing is based on the disk yet, and it is
        // compared when activated (OpenFromPathAsync).
        foreach (var open in Workspace.Open.Select(f => f.Path).Where(_known.ContainsKey).ToList())
        {
            await CheckOpenFileAsync(open, RepositoryChangeKind.ChangedOrCreated);
        }
    }

    /// <summary>
    /// The window connected again (backlog 264). A reload sent while it was away was never delivered (Blazor Server does
    /// not replay a JavaScript call to a reconnected window, measured on v0.9.69), and its buffer's disk stamp was left as it was, so looking again
    /// finds that file changed and sends it now. A buffer already in step sends nothing.
    /// </summary>
    private void OnReconnected()
    {
        RunLookAgain("after the window connected again");

        // Work item #366: a diff or a highlight pushed while the window was away was never delivered either.
        FollowReconnected();
    }

    private void RunLookAgain(string reason)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LookAgainAtOpenBuffersAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit going away; the next circuit re-reads from disk anyway.
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Checking the open buffers {Reason} failed.", reason);
            }
        });
    }

    /// <summary>How long the window has to confirm a reload before it counts as not delivered (backlog 264).</summary>
    internal static readonly TimeSpan ApplyTimeout = TimeSpan.FromSeconds(5);

    /// <summary>
    /// Sends a file's new text to its editor buffer; false when the window did not confirm it within
    /// <see cref="ApplyTimeout"/> (Blazor's own bound is one minute, which is what the look-again waited on v0.9.69). The
    /// caller then leaves the buffer's disk stamp alone, so the next look finds the file changed again. That next look is
    /// the reconnection's when the window is known to be away, or one scheduled here when it is not (the server notices a
    /// dead connection only later, or the window is slow).
    /// </summary>
    private async Task<bool> TryApplyExternalContentAsync(string path, string content, string? stamp)
    {
        try
        {
            await JS.InvokeVoidAsync("fravashiCode.applyExternalContent", ApplyTimeout, path, content, stamp);
            return true;
        }
        catch (OperationCanceledException)
        {
            // Expected while the window is disconnected: one line, no stack trace.
            Logger.LogInformation(
                "The window did not confirm the reload of {Path} within {Seconds} s; it is sent again when the window is reachable.",
                path, ApplyTimeout.TotalSeconds);
            if (Connection.IsUp)
            {
                QueueLookAgain();
            }

            return false;
        }
    }

    /// <summary>One delayed look-again at a time, for a reload that failed while the connection was reported up.</summary>
    private void QueueLookAgain()
    {
        if (_lookAgainQueued)
        {
            return;
        }

        _lookAgainQueued = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(ApplyTimeout);
            _lookAgainQueued = false;
            if (!_disposed)
            {
                RunLookAgain("after a reload was not confirmed");
            }
        });
    }

    /// <summary>Brings one open buffer in step with its file on disk, or raises the banner when it cannot (ADR 0016).</summary>
    private async Task CheckOpenFileAsync(string path, RepositoryChangeKind kind)
    {
        if (kind == RepositoryChangeKind.Deleted)
        {
            if (await DropMissingPreviewAsync(path, _previewActive))
            {
                StateHasChanged(); // work item #371: a deleted file's preview tab closes itself
                return;
            }

            _known.Remove(path);
            _alerts[path] = FileAlert.DeletedOnDisk;
            StateHasChanged();
            return;
        }

        // An open image re-renders directly; text goes through the clean/dirty split.
        if (ImageMimeTypes.ContainsKey(System.IO.Path.GetExtension(path)))
        {
            if (path == Workspace.ActivePath)
            {
                await OpenFromPathAsync(path);
                StateHasChanged();
            }

            return;
        }

        var file = await Reader.ReadFileAsync(path);
        if (file is null)
        {
            if (await DropMissingPreviewAsync(path, _previewActive))
            {
                StateHasChanged(); // work item #371: a deleted file's preview tab closes itself
                return;
            }

            _alerts[path] = FileAlert.DeletedOnDisk;
            StateHasChanged();
            return;
        }

        if (file.IsTruncated || (_known.TryGetValue(path, out var known) && file.LastWriteUtc == known))
        {
            return; // grew past the edit cap (leave the buffer alone), or our own write echoing back
        }

        if (IsUnsaved(path))
        {
            _alerts[path] = FileAlert.ChangedOnDisk;
        }
        else
        {
            if (!await TryApplyExternalContentAsync(path, file.Content, file.LastWriteUtc?.ToString("O")))
            {
                return; // not delivered: the stamp stays, so the next look-again sends it
            }

            if (file.LastWriteUtc is { } stamp)
            {
                _known[path] = stamp;
            }

            _alerts.Remove(path);
            if (path == Workspace.ActivePath)
            {
                RefreshActiveText(file.Content);
            }

            // Work item #366: a change follow showed (or opened the file for) has landed on the host.
            FollowedFileLanded(path, file.Content);
        }

        StateHasChanged();
    }

    /// <summary>Coalesce watcher bursts into one tree reload.</summary>
    private void QueueTreeRefresh()
    {
        if (_treeRefreshQueued)
        {
            return;
        }

        _treeRefreshQueued = true;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400);
                _treeRefreshQueued = false;
                await RefreshTreeAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                _treeRefreshQueued = false;
                Logger.LogWarning(ex, "Refreshing the tree after a repository change failed.");
            }
        });
    }

    /// <summary>Keep the server-side copy of the active text (previews) in step with an external reload.</summary>
    private void RefreshActiveText(string content)
    {
        if (_view.Kind != ViewKind.Text)
        {
            return;
        }

        _view = _view with { TextContent = _view.PreviewMode == PreviewMode.None ? null : content };
        if (!_previewActive)
        {
            return;
        }

        if (_view.PreviewMode == PreviewMode.Markdown)
        {
            _previewHtml = MarkdownPreview.ToHtml(content);
        }
        else if (_view.PreviewMode == PreviewMode.Svg)
        {
            _previewDataUrl = "data:image/svg+xml;base64,"
                + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(content));
        }
    }

    private async Task ReloadFromDiskAsync(string path)
    {
        var file = await Reader.ReadFileAsync(path);
        if (file is null)
        {
            _alerts[path] = FileAlert.DeletedOnDisk;
            StateHasChanged();
            return;
        }

        if (!await TryApplyExternalContentAsync(path, file.Content, file.LastWriteUtc?.ToString("O")))
        {
            return; // not delivered: the banner and the unsaved state stay, so the person can press it again
        }

        if (file.LastWriteUtc is { } stamp)
        {
            _known[path] = stamp;
        }

        _dirty.Remove(path);
        _forceSave.Remove(path);
        _alerts.Remove(path);
        if (path == Workspace.ActivePath)
        {
            RefreshActiveText(file.Content);
        }

        StateHasChanged();
    }

    private async Task OverwriteDiskAsync(string path)
    {
        _forceSave.Add(path);
        await SaveAsync(path);
    }

    private Task KeepDeletedAsync(string path)
    {
        // The buffer becomes the only copy; the next save (forced) recreates the file on disk.
        _alerts.Remove(path);
        _forceSave.Add(path);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task CloseAfterDeleteAsync(string path)
    {
        ForgetFileState(path);
        await DoCloseAsync(path);
    }

