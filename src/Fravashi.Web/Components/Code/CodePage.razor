    // ---- Tab operations ----

    private Task PinAsync(string path, bool pinned)
    {
        Workspace.SetPinned(path, pinned);
        _pendingPersist = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Run a bulk workspace change, then reconcile Monaco models, the URL, and persistence.</summary>
    private async Task ApplyTabOperationAsync(Action operation)
    {
        var before = Workspace.Open.Select(f => f.Path).ToList();
        var activeBefore = Workspace.ActivePath;
        operation();
        var after = Workspace.Open.Select(f => f.Path).ToHashSet();
        foreach (var closed in before.Where(p => !after.Contains(p)))
        {
            await JS.InvokeVoidAsync("fravashiCode.close", closed);
            ForgetFileState(closed);
        }

        _pendingPersist = true;
        if (Workspace.ActivePath != activeBefore)
        {
            if (Workspace.ActivePath is { } next)
            {
                await OpenFromPathAsync(next);
                Nav.NavigateTo($"/code/{next}");
            }
            else
            {
                _view = new ActiveView(ViewKind.None);
                Nav.NavigateTo("/code");
            }
        }

        StateHasChanged();
    }

    /// <summary>Bulk closes stop at a confirm dialog when they would discard unsaved buffers.</summary>
    private Task CloseOthersGuardedAsync(string keep) =>
        GuardedBulkAsync(
            Workspace.Unpinned.Where(f => f.Path != keep).Select(f => f.Path).ToList(),
            () => Workspace.CloseOthers(keep));

    private Task CloseToTheRightGuardedAsync(string from)
    {
        var unpinned = Workspace.Unpinned.ToList();
        var index = unpinned.FindIndex(f => f.Path == from);
        var doomed = index < 0 ? [] : unpinned.Skip(index + 1).Select(f => f.Path).ToList();
        return GuardedBulkAsync(doomed, () => Workspace.CloseToTheRight(from));
    }

    private Task CloseAllButPinnedGuardedAsync() =>
        GuardedBulkAsync(Workspace.Unpinned.Select(f => f.Path).ToList(), Workspace.CloseAllButPinned);

    private Task CloseAllGuardedAsync() =>
        GuardedBulkAsync(Workspace.Open.Select(f => f.Path).ToList(), Workspace.CloseAll);

    private async Task GuardedBulkAsync(IReadOnlyList<string> doomed, Action operation)
    {
        var unsaved = doomed.Where(IsUnsaved).ToList();
        if (unsaved.Count > 0)
        {
            _pendingClose = new PendingClose(unsaved, () => ApplyTabOperationAsync(operation));
            StateHasChanged();
            return;
        }

        await ApplyTabOperationAsync(operation);
    }

    private async Task ResolvePendingCloseAsync(bool save)
    {
        if (_pendingClose is not { } pending)
        {
            return;
        }

        _pendingClose = null;
        if (save)
        {
            foreach (var path in pending.DirtyPaths)
            {
                await SaveAsync(path);
            }

            // A save that conflicted or failed leaves its file unsaved; abort so nothing is lost.
            if (pending.DirtyPaths.Any(IsUnsaved))
            {
                StateHasChanged();
                return;
            }
        }
        else
        {
            foreach (var path in pending.DirtyPaths)
            {
                _dirty.Remove(path);
                _forceSave.Remove(path);
            }
        }

        await pending.Proceed();
    }

    private void ForgetFileState(string path)
    {
        _dirty.Remove(path);
        _forceSave.Remove(path);
        _known.Remove(path);
        _alerts.Remove(path);
    }

    // ---- Clipboard / file operations ----

    private Task SetClipboard(string path, bool isCut)
    {
        _clipboard = (path, isCut);
        return Task.CompletedTask;
    }

    private async Task CopyToClipboardAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("fravashiCode.copyText", text);
        }
        catch (JSException)
        {
            Notifications.Add("Could not write to the clipboard.", NotificationSeverity.Warning);
        }
    }

    private string AbsolutePathOf(string relativePath) =>
        System.IO.Path.Combine(Reader.RootPath, relativePath.Replace('/', System.IO.Path.DirectorySeparatorChar));

    private async Task PasteIntoAsync(string targetDirectory)
    {
        if (_clipboard is not { } clip)
        {
            return;
        }

        var result = clip.IsCut
            ? await Writer.MoveAsync(clip.Path, targetDirectory)
            : await Writer.CopyAsync(clip.Path, targetDirectory);
        if (!result.Succeeded)
        {
            Notifications.Add(result.Error ?? "The paste failed.", NotificationSeverity.Warning);
            return;
        }

        if (clip.IsCut)
        {
            _clipboard = null;
        }

        await RefreshTreeAsync();
        StateHasChanged();
    }

    private Task OpenPrompt(string targetDirectory, bool isFile)
    {
        _prompt = new NamePrompt(targetDirectory, isFile);
        _promptName = string.Empty;
        _promptError = null;
        // The box starts empty, so there is nothing to select.
        _pendingFocus = ("[data-testid=code-prompt-name]", false);
        return Task.CompletedTask;
    }

    /// <summary>Enter creates, Escape dismisses: the new-file/new-folder prompt needs no mouse.</summary>
    private async Task NamePromptKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ConfirmPromptAsync();
        }
        else if (args.Key == "Escape")
        {
            _prompt = null;
        }
    }

    private async Task ConfirmPromptAsync()
    {
        if (_prompt is not { } prompt || string.IsNullOrWhiteSpace(_promptName))
        {
            return;
        }

        var name = _promptName.Trim();
        var result = prompt.IsFile
            ? await Writer.CreateFileAsync(prompt.TargetDirectory, name)
            : await Writer.CreateDirectoryAsync(prompt.TargetDirectory, name);
        if (!result.Succeeded)
        {
            _promptError = result.Error;
            return;
        }

        _prompt = null;
        if (prompt.TargetDirectory.Length > 0)
        {
            _expanded.Add(prompt.TargetDirectory);
        }

        await RefreshTreeAsync();
        if (prompt.IsFile)
        {
            var newPath = prompt.TargetDirectory.Length == 0 ? name : $"{prompt.TargetDirectory}/{name}";
            NavigateToFile(newPath);
        }

        StateHasChanged();
    }

    // ---- Rename and delete-to-trash (owner batch 2026-07-26) ----

    private Task OpenRenamePrompt(RepositoryNode node)
    {
        _rename = new RenamePrompt(node.RelativePath, node.IsDirectory);
        _renameName = node.Name;
        _renameError = null;
        // Pre-filled with the current name: select it, so typing replaces rather than appends.
        _pendingFocus = ("[data-testid=code-rename-name]", true);
        return Task.CompletedTask;
    }

    /// <summary>Enter renames, Escape dismisses (the same keyboard contract as the name prompt).</summary>
    private async Task RenamePromptKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ConfirmRenameAsync();
        }
        else if (args.Key == "Escape")
        {
            _rename = null;
        }
    }

    private async Task ConfirmRenameAsync()
    {
        if (_rename is not { } rename || string.IsNullOrWhiteSpace(_renameName))
        {
            return;
        }

        var newName = _renameName.Trim();
        var result = await Writer.RenameAsync(rename.Path, newName);
        if (!result.Succeeded)
        {
            _renameError = result.Error;
            return;
        }

        _rename = null;
        var parent = DirectoryOf(rename.Path);
        var newPath = parent.Length == 0 ? newName : $"{parent}/{newName}";
        await RemapAfterRenameAsync(rename.Path, newPath, rename.IsDirectory);
        _lastFileOp = new LastFileOp(
            $"rename {newName} back to {FileNameOf(rename.Path)}",
            () => UndoRenameAsync(newPath, rename.Path, rename.IsDirectory));
        await RefreshTreeAsync();
        StateHasChanged();
    }

    /// <summary>Reverses a rename: the file (or folder) goes back to its previous name, buffers follow.</summary>
    private async Task<string?> UndoRenameAsync(string currentPath, string originalPath, bool isDirectory)
    {
        var result = await Writer.RenameAsync(currentPath, FileNameOf(originalPath));
        if (!result.Succeeded)
        {
            return result.Error;
        }

        await RemapAfterRenameAsync(currentPath, originalPath, isDirectory);
        return null;
    }

    private async Task UndoLastFileOpAsync()
    {
        if (_lastFileOp is not { } op)
        {
            return;
        }

        _lastFileOp = null; // one level deep, and never retried against a changed tree
        var error = await op.UndoAsync();
        Notifications.Add(
            error is null ? $"Undone: {op.Label}." : $"Undo failed: {error}",
            error is null ? NotificationSeverity.Success : NotificationSeverity.Error);
        await RefreshTreeAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Carry every open tab under a renamed path over to its new identity: the Monaco model re-keys
    /// client-side (content, dirty state, and hot-exit backup survive), and the server-side dirty /
    /// timestamp / alert tracking moves with it. The tree's expansion state follows for folders.
    /// </summary>
    private async Task RemapAfterRenameAsync(string oldPath, string newPath, bool isDirectory)
    {
        if (isDirectory)
        {
            var oldPrefix = oldPath + "/";
            foreach (var key in _expanded.Where(p => p == oldPath || p.StartsWith(oldPrefix, StringComparison.Ordinal)).ToList())
            {
                _expanded.Remove(key);
                _expanded.Add(newPath + key[oldPath.Length..]);
            }

            // Cached child listings hold stale RelativePaths; drop them and let expansion re-load.
            foreach (var key in _childrenCache.Keys.Where(p => p == oldPath || p.StartsWith(oldPrefix, StringComparison.Ordinal)).ToList())
            {
                _childrenCache.Remove(key);
            }
        }

        var activeBefore = Workspace.ActivePath;
        foreach (var file in Workspace.Open.ToList())
        {
            string? mapped = null;
            if (!isDirectory && file.Path == oldPath)
            {
                mapped = newPath;
            }
            else if (isDirectory && file.Path.StartsWith(oldPath + "/", StringComparison.Ordinal))
            {
                mapped = newPath + file.Path[oldPath.Length..];
            }

            if (mapped is null)
            {
                continue;
            }

            await JS.InvokeVoidAsync("fravashiCode.rename", file.Path, mapped);
            MoveFileState(file.Path, mapped);
            Workspace.Remap(file.Path, mapped, FileNameOf(mapped));
        }

        _pendingPersist = true;
        if (activeBefore is not null && Workspace.ActivePath is { } active && active != activeBefore)
        {
            Nav.NavigateTo($"/code/{active}", replace: true);
        }
    }

    private void MoveFileState(string oldPath, string newPath)
    {
        if (_dirty.Remove(oldPath))
        {
            _dirty.Add(newPath);
        }

        if (_forceSave.Remove(oldPath))
        {
            _forceSave.Add(newPath);
        }

        if (_known.Remove(oldPath, out var stamp))
        {
            _known[newPath] = stamp;
        }

        if (_alerts.Remove(oldPath, out var alert))
        {
            _alerts[newPath] = alert;
        }
    }

    private Task OpenDeleteConfirm(RepositoryNode node)
    {
        _deleteTarget = new DeleteTarget(node.RelativePath, node.IsDirectory);
        return Task.CompletedTask;
    }

    private IReadOnlyList<string> OpenTabsUnder(string path) =>
        Workspace.Open.Select(f => f.Path)
            .Where(p => p == path || p.StartsWith(path + "/", StringComparison.Ordinal))
            .ToList();

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is not { } target)
        {
            return;
        }

        _deleteTarget = null;
        var result = await Trash.DeleteToTrashAsync([target.Path]);
        if (!result.Succeeded)
        {
            Notifications.Add(result.Error ?? $"Deleting {target.Path} failed.", NotificationSeverity.Error);
            StateHasChanged();
            return;
        }

        // The zip holds the on-disk content; buffer state is discarded so the closes never prompt.
        var affected = OpenTabsUnder(target.Path);
        foreach (var path in affected)
        {
            ForgetFileState(path);
        }

        await ApplyTabOperationAsync(() =>
        {
            foreach (var path in affected)
            {
                Workspace.Close(path);
            }
        });

        if (target.IsDirectory)
        {
            var prefix = target.Path + "/";
            _expanded.RemoveWhere(p => p == target.Path || p.StartsWith(prefix, StringComparison.Ordinal));
            foreach (var key in _childrenCache.Keys.Where(p => p == target.Path || p.StartsWith(prefix, StringComparison.Ordinal)).ToList())
            {
                _childrenCache.Remove(key);
            }
        }

        if (result.ZipFileName is { } zipName)
        {
            _lastFileOp = new LastFileOp(
                $"restore {target.Path} from trash",
                async () => (await Trash.RestoreAsync(zipName)) is { Succeeded: false } restore ? restore.Error : null);
        }

        Notifications.Add($"{target.Path} moved to trash ({result.ZipFileName}).", NotificationSeverity.Info);
        await RefreshTreeAsync();
        StateHasChanged();
    }

