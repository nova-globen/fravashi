    /// <summary>The last value this session's overlay sets for <paramref name="property"/> on the node, if any.</summary>
    private static string? CurrentStyle(PrototypeEditSession session, PrototypeRenderedAnchor node, string property)
    {
        string? value = null;
        foreach (var operation in session.Overlay)
        {
            if (operation is PrototypeSetCssOperation css && Same(css.Anchor, node.Anchor)
                && css.Properties.TryGetValue(property, out var set))
            {
                value = set;
            }
        }

        return value;
    }

    private static bool Same(PrototypeAnchor a, PrototypeAnchor b) =>
        a.Part == b.Part && a.Column == b.Column
        && ((a.Id is not null && a.Id == b.Id) || (a.Path is not null && a.Path == b.Path));

    private static IReadOnlyList<string>? Choices(string property) => property switch
    {
        "font-weight" => ["normal", "bold", "300", "400", "500", "600", "700", "800"],
        "text-align" => ["left", "center", "right", "justify"],
        _ => null,
    };

    private static string StyleLabel(string property) => property switch
    {
        "color" => "Colour",
        "background-color" => "Background",
        "font-size" => "Font size",
        "font-weight" => "Font weight",
        "padding" => "Padding",
        "margin" => "Margin",
        "text-align" => "Alignment",
        _ => property,
    };

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? string.Empty;

    private string FrameStyle(MockupDocument design) =>
        design.Viewports.FirstOrDefault(v => v.Name == _viewport) is { } viewport
            ? $"width: {viewport.Width.ToString(CultureInfo.InvariantCulture)}px"
            : "width: 100%";

    private static string ScreenName(MockupNode screen, int index) =>
        screen.Text ?? screen.Id ?? $"Screen {(index + 1).ToString(CultureInfo.InvariantCulture)}";

    private static string Describe(PrototypeUnexpressedOverride unexpressed) =>
        unexpressed.State is { } state
            ? $"{unexpressed.Anchor}: {unexpressed.Property} in the {state} state"
            : $"{unexpressed.Anchor}: {unexpressed.Property} at the {unexpressed.Viewport} viewport";

    public async ValueTask DisposeAsync()
    {
        if (_listener is { } handle)
        {
            _listener = null;
            try
            {
                await JS.InvokeVoidAsync("fravashiPrototypeEdit.detach", handle);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and so is the window the listener was on.
            }
        }

        _self?.Dispose();
    }
