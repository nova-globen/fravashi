    };

    private async Task LoadAsync()
    {
        // Item #373: a folder that is not set up shows the "not set up" state and reads no project.
        if (!CurrentProject.IsSetUp())
        {
            return;
        }

        _items = await Wiki.ListAsync(new WikiItemQuery
        {
            Types = _type is { } type ? [type] : null,
            Text = _search.Length == 0 ? null : _search,
            Limit = 1000,
        });

        _item = Number is { } number ? await Wiki.GetByNumberAsync(number) : null;
        if (_item is null)
        {
            _rendered = string.Empty;
            _renderedAfter = string.Empty;
            _design = null;
            _prototype = null;
            _prototypeDesign = null;
            _prototypeTree = null;
            _prototypeTreeProblem = null;
            _backlinks = [];
            _linkingItems = [];
            _headings = [];
            return;
        }

        // Resolved once for the whole body, then rendered synchronously: a renderer that queried per
        // reference would stall the page on a document that cites fifty things.
        var references = await References.ResolveAsync(CurrentProject.Require(), _item.Body);
        _design = _item.Type == WikiItemType.Design ? DesignMockup.Read(_item.Body) : null;

        // Backlog 211: a prototype names its design, pinned to a version, so the page can say "the design
        // has changed since" without the reader doing I/O twice: one lookup here, for the banner's words.
        _prototype = _item.Type == WikiItemType.Prototype ? await PrototypeBody.ReadAsync(_item.Body, Wiki) : null;
        _prototypeDesign = _prototype?.Document is { } prototypeDocument
            ? await Wiki.GetByNumberAsync(prototypeDocument.Design.Number)
            : null;
        (_prototypeTree, _prototypeTreeProblem) = await PinnedTreeAsync();

        if (_design?.Block is { } block)
        {
            // The prose on either side of the block, rendered apart so the block's place can hold the placeholder.
            // The block is a top-level fence, so cutting there splits no other markdown construct.
            _rendered = Renderer.ToHtml(_item.Body[..block.Start], references);
            _renderedAfter = Renderer.ToHtml(_item.Body[(block.Start + block.Length)..], references);
        }
        else
        {
            // None or several: the body renders as written, so every block's JSON is still on the page.
            _rendered = Renderer.ToHtml(_item.Body, references);
            _renderedAfter = string.Empty;
        }

        // Work item #365: file paths become previewable links, and the headings are what "On this page" lists.
        _rendered = WikiReading.LinkFilePaths(_rendered);
        _renderedAfter = WikiReading.LinkFilePaths(_renderedAfter);
        _headings = [.. WikiReading.Headings(_rendered), .. WikiReading.Headings(_renderedAfter)];

        _backlinks = await Wiki.BacklinksAsync(_item.Reference);
        _linkingItems = await LinkingItemsAsync(_item.Number);
    }

    /// <summary>
    /// The work items that name this document (work item #365): its plan reference or an @N in their text, one query
    /// to the store (<see cref="WorkItemQuery.NamesWikiDocument"/>). None where the page has no tracker wired.
    /// </summary>
    private async Task<IReadOnlyList<WorkItem>> LinkingItemsAsync(int number)
    {
        if (Services.GetService<ITrackerResolver>() is not { } trackers)
        {
            return [];
        }

        var tracker = trackers.For(CurrentProject.Require());
        var found = new List<WorkItem>();
        string? cursor = null;
        do
        {
            var page = await tracker.QueryAsync(new WorkItemQuery
            {
                NamesWikiDocument = number,
                Limit = WorkItemQuery.MaxLimit,
                Cursor = cursor,
            });
            found.AddRange(page.Items);
            cursor = page.NextCursor;
        }
        while (cursor is not null);

        return found;
    }

    /// <summary>
    /// Backlog 213: the tree a prototype renders from is its design AT THE PINNED VERSION (the version is the
    /// prototype's whole claim about what it was generated from; regenerating onto a newer one is #216's act, an explicit
    /// button on the viewer), or
    /// why there is none, in words. Read by <see cref="PrototypePinnedDesign"/>, the same reader the agent tools use.
    /// </summary>
    private async Task<(Fravashi.Application.Mockups.MockupDocument? Tree, string? Problem)> PinnedTreeAsync()
    {
        if (_prototype?.Document is not { } prototype)
        {
            return (null, null);
        }

        var pinned = await PrototypePinnedDesign.ReadAsync(Wiki, _prototypeDesign, prototype);
        return (pinned.Tree, pinned.Problem);
    }

    private void Open(WikiItem item)
    {
        _draft = null;
        _drawing = false;
        Nav.NavigateTo($"/wiki/{item.Number}");
    }

    private async Task OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
