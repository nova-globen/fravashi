    private async Task PublishAllAsync()
    {
        _publishingAll = true;
        _publishAll = null;
        try
        {
            var everything = await Wiki.ListAsync(new WikiItemQuery { Limit = 1000 });
            _publishAll = await Publisher.PublishAllAsync(everything, (done, total) =>
            {
                _publishDone = done;
                _publishTotal = total;
                _ = InvokeAsync(StateHasChanged);
            });
        }
        finally
        {
            _publishingAll = false;
        }

        await LoadAsync();
    }

    private bool Filtering => _search.Length > 0 || _type is not null;

    /// <summary>The documents above this one, top first, as far as they are in this project's list.</summary>
    private List<WikiItem> Ancestors(WikiItem item)
    {
        var byId = _items.ToDictionary(i => i.Id, StringComparer.Ordinal);
        var chain = new List<WikiItem>();
        var seen = new HashSet<string>(StringComparer.Ordinal);
        for (var at = item.ParentId; at is not null && seen.Add(at) && byId.TryGetValue(at, out var parent); at = parent.ParentId)
        {
            chain.Insert(0, parent);
        }

        return chain;
    }

    /// <summary>Where a document may be put: anywhere but under itself or its own descendants.</summary>
    private IEnumerable<WikiItem> ParentCandidates(WikiItem? moving)
    {
        var excluded = new HashSet<string>(StringComparer.Ordinal);
        if (moving is not null)
        {
            excluded.Add(moving.Id);
            bool added;
            do
            {
                added = false;
                foreach (var item in _items.Where(i => i.ParentId is { } p && excluded.Contains(p) && !excluded.Contains(i.Id)))
                {
                    excluded.Add(item.Id);
                    added = true;
                }
            }
            while (added);
        }

        return _items.Where(i => !excluded.Contains(i.Id)).OrderBy(i => i.Number);
    }

