    /// <summary>
    /// A type to filter by, by its stable name (<c>/wiki?type=plan</c>): where Home's Wiki card sends a person who
    /// clicked one of its bars (work item #358).
    /// </summary>
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    /// <summary>The query's type as last applied, so a person's own choice in the filter is not overwritten on every render.</summary>
    private string? _appliedTypeQuery;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(TypeQuery, _appliedTypeQuery, StringComparison.Ordinal))
        {
            _appliedTypeQuery = TypeQuery;
            if (Types.Where(t => string.Equals(WikiNames.ToName(t), TypeQuery, StringComparison.Ordinal))
                    .Cast<WikiItemType?>().FirstOrDefault() is { } match)
            {
                _type = match;
            }
        }

        if (Number != _shownNumber)
        {
            // A different document: the preview of something in the last one goes, and the new one starts at its top.
            _shownNumber = Number;
            _previews.Close();
            _scrollToTop = true;
        }

        await LoadAsync();
    }

    private static string Label(WikiItemType type) => type switch
    {
        WikiItemType.Adr => "ADR",
