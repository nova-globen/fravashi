    private async Task NewDesignAsync()
    {
        _error = null;
        var created = await Wiki.CreateAsync(new NewWikiItem
        {
            Type = WikiItemType.Design,
            Title = DesignMockup.NewTitle,
            Body = DesignMockup.NewBody(),
        });

        if (!created.IsValid)
        {
            _error = string.Join(" ", created.Errors.Select(e => e.Message));
            return;
        }

        Nav.NavigateTo($"/wiki/{created.Value.Number}/design");
    }

    private void BeginEdit()
    {
        _error = null;
        _draft = _item is { } item
            ? new WikiDraft { Existing = item, Title = item.Title, Body = item.Body, Type = item.Type, ParentId = item.ParentId }
            : new WikiDraft();
    }

    private void CancelEdit()
    {
        _draft = null;
        _error = null;
    }

    /// <summary>Saves through the port and shows the model's own refusal rather than one invented here.</summary>
    private async Task SaveAsync()
    {
        if (_draft is not { } draft)
        {
            return;
        }

        _error = null;

        if (draft.Existing is { } existing)
        {
            var updated = await Wiki.UpdateAsync(
                existing.Id,
                new WikiItemEdit
                {
                    Title = draft.Title,
                    Body = draft.Body,
                    Type = draft.Type,
                    Parent = draft.ParentId == existing.ParentId ? null : new WikiParentChange(draft.ParentId),
                },
                existing.Version);

            if (!updated.IsValid)
            {
                _error = string.Join(" ", updated.Errors.Select(e => e.Message));
                await LoadAsync();
                return;
            }

            _draft = null;
            await LoadAsync();
            return;
        }

        var created = await Wiki.CreateAsync(new NewWikiItem
        {
            Type = draft.Type,
            Title = draft.Title,
            Body = draft.Body,
            ParentId = draft.ParentId,
        });

        if (!created.IsValid)
        {
            _error = string.Join(" ", created.Errors.Select(e => e.Message));
            return;
        }

        _draft = null;
        await LoadAsync();
        Open(created.Value);
    }

    private static WikiItemType ParseType(object? value, WikiItemType current)
    {
        try
        {
            return WikiNames.Parse<WikiItemType>(value?.ToString());
        }
        catch (InvalidDataException)
        {
            // A value no type has means the browser sent something the page never offered; keep the choice
            // that was already made rather than guessing a different one.
            return current;
        }
    }
