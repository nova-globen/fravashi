<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Persistence: SQLite (ADR 0003 V6). Microsoft.Data.Sqlite is MIT, authored by Microsoft, and
         bundles the native e_sqlite3 library so it runs in the Linux runtime container with no system
         SQLite. The vector seam (sqlite-vec, etc.) loads via SqliteConnection.LoadExtension when adopted. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- The agent browser (backlog 159): Playwright's .NET binding, MIT (nuspec verified 2026-09-27). It ships its
         driver (playwright-core, Apache-2.0) and a Node binary per platform; the image runs the driver on its own Node
         instead and strips the bundled ones. The Dockerfile's PLAYWRIGHT_VERSION arg installs the browser this exact
         version pins (Chromium headless shell revision 1243), and PlaywrightPinTests holds the two equal. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />

    <!-- Backlog 40 (decided 2026-09-19): the embedder behind wiki search by meaning. MIT, read from
         the repository LICENSE at tag v1.30.0 because the nuspec says license type="file". It carries
         linux-x64 and linux-arm64 glibc natives, which is what the Debian runtime image is. The model
         weights are NOT in this package: they are pinned by revision and checksum in the Dockerfile. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />

    <!-- Transitive-safety pin: Microsoft.Data.Sqlite 10.0.10 resolves SQLitePCLRaw.bundle_e_sqlite3 2.1.11,
         whose native SQLitePCLRaw.lib.e_sqlite3 2.1.11 carries the NU1903 high-severity advisory
         GHSA-2m69-gcr7-jv3q (bundled SQLite < 3.50.2). 2.1.12 is the next release on the same 2.1.x line —
         API-compatible with Microsoft.Data.Sqlite — and its native lib is off the advisory. Central
         transitive pinning propagates this to the bundle's lib/core/provider dependencies. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />

    <!-- Core extensions -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />

    <!-- UI: Fluent Blazor (the company platform standard) -->
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.3" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.3" />

    <!-- The borderless studio window shell (ADR 0014): the studio window hosts the studio in WebView2 so the
         window is chromeless with in-app caption controls and full keyboard capture (Ctrl+Tab/Ctrl+F4
         reach the app, unlike any browser tab). Owner-approved license exception, 2026-07-26, see
         .githooks/licenses.approved. -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />

    <!-- Docs/markdown rendering + source preview highlighting -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Markdown.ColorCode" Version="3.0.1" />

    <!-- Serialization used by the copied tracker/agent/sync code -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />

    <!-- Transitive-safety pin: MessagePack 2.5.192 carried the NU1903 high-severity advisory
         GHSA-hv8m-jj95-wg3x. Pinned to the current 3.x line so any transitive resolution (e.g. via the
         SignalR stack behind Blazor Server) stays off the advisory. No project references the SignalR
         MessagePack protocol package directly. -->
    <PackageVersion Include="MessagePack" Version="3.1.7" />

    <!-- Transitive-safety pin: bunit 2.7.2 depends on AngleSharp >= 1.4.0, and 1.4.0 carries the
         NU1902 moderate-severity advisory GHSA-pgww-w46g-26qg (mXSS via MathML <annotation-xml>
         mis-parsing; first patched in 1.5.0). 1.5.x is an API-compatible minor bump on the same 1.x
         line that bunit's floor (>= 1.4.0) accepts; central transitive pinning propagates it to the
         bunit HTML/diffing path. Pinned to the latest patch of the fixed line. Verified bunit's HTML
         assertions still pass under this version. -->
    <PackageVersion Include="AngleSharp" Version="1.5.2" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="bunit" Version="2.7.2" />

    <!-- FluentAssertions replaced 2026-07-23: v8.0+ moved to the Xceed Community License (non-commercial
         use only), failing the dependency license gate (.githooks/pre-commit, see CLAUDE.md). AwesomeAssertions
         is a community fork created the same week in direct response, kept on Apache-2.0 with an explicit
         "will never change license" commitment (verified via nuspec + GitHub LICENSE, 2026-07-23). Same public
         API surface as FluentAssertions 8.x; only the namespace changed. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>
</Project>
